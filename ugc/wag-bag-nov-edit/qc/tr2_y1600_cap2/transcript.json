ntagon told military races", "words": [{"word": " but", "start": 17.58, "end": 17.74}, {"word": " the", "start": 17.74, "end": 17.92}, {"word": " Pentagon", "start": 17.92, "end": 18.3}, {"word": " told", "start": 18.3, "end": 18.6}, {"word": " military", "start": 18.6, "end": 19.08}, {"word": " races", "start": 19.08, "end": 19.4}]}, {"start": 19.4, "end": 21.98, "text": " to be ready for 90 days without outside help.", "words": [{"word": " to", "start": 19.4, "end": 19.62}, {"word": " be", "start": 19.62, "end": 19.74}, {"word": " ready", "start": 19.74, "end": 19.94}, {"word": " for", "start": 19.94, "end": 20.16}, {"word": " 90", "start": 20.16, "end": 20.52}, {"word": " days", "start": 20.52, "end": 20.78}, {"word": " without", "start": 20.78, "end": 21.08}, {"word": " outside", "start": 21.08, "end": 21.6}, {"word": " help.", "start": 21.6, "end": 21.98}]}, {"start": 22.16, "end": 23.38, "text": " We need to prepare too.", "words": [{"word": " We", "start": 22.16, "end": 22.38}, {"word": " need", "start": 22.38, "end": 22.52}, {"word": " to", "start": 22.52, "end": 22.68}, {"word": " prepare", "start": 22.68, "end": 22.96}, {"word": " too.", "start": 22.96, "end": 23.38}]}, {"start": 23.66, "end": 26.04, "text": " These wag bags contain a NASA-developed powder", "words": [{"word": " These", "start": 23.66, "end": 23.92}, {"word": " wag", "start": 23.92, "end": 24.2}, {"word": " bags", "start": 24.2, "end": 24.36}, {"word": " contain", "start": 24.36, "end": 24.82}, {"word": " a", "start": 24.82, "end": 25.02}, {"word": " NASA", "start": 25.02, "end": 25.28}, {"word": "-developed", "start": 25.28, "end": 25.66}, {"word": " powder", "start": 25.66, "end": 26.04}]}, {"start": 26.04, "end": 27.92, "text": " that helps turn waste into gel", "words": [{"word": " that", "start": 26.04, "end": 26.3}, {"word": " helps", "start": 26.3, "end": 26.54}, {"word": " turn", "start": 26.54, "end": 26.88}, {"word": " waste", "start": 26.88, "end": 27.14}, {"word": " into", "sta
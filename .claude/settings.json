{
  "env": {
    "HYPERFRAMES_NO_TELEMETRY": "1",
    "DO_NOT_TRACK": "1",
    "KAPSO_TELEMETRY_DISABLED": "1",
    "CAMOFOX_CRASH_REPORT_ENABLED": "false",
    "IMPECCABLE_NO_TELEMETRY": "1",
    "BASH_MAX_OUTPUT_LENGTH": "20000"
  },
  "enabledMcpjsonServers": [
    "camofox-browser",
    "broll",
    "playwright"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/browser_setup.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/camofox_setup.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/broll_setup.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.git/**)"
    ]
  }
}

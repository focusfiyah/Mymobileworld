{
  "env": {
    "HYPERFRAMES_NO_TELEMETRY": "1",
    "DO_NOT_TRACK": "1",
    "CAMOFOX_CRASH_REPORT_ENABLED": "false",
    "IMPECCABLE_NO_TELEMETRY": "1",
    "BASH_MAX_OUTPUT_LENGTH": "20000"
  },
  "enabledMcpjsonServers": [
    "camofox-browser",
    "broll",
    "playwright"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/browser_setup.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/camofox_setup.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/broll_setup.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/telegram_hello.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/context_watch.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|mcp__Google_Drive__read_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/skills/markitdown/scripts/read_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.git/**)"
    ]
  }
}
